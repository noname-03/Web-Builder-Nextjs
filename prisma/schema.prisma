generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PageStatus {
  DRAFT
  READY
}

enum VersionSource {
  MANUAL
  EXPORT
  RESTORE
}

enum AiMode {
  GENERATE
  MODIFY
}

enum AiStatus {
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions      Session[]
  projects      Project[]
  exportLogs    ExportLog[]
  templates     Template[]
  aiProviders   AiProvider[]
  aiGenerations AiGeneration[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(255)
  ipAddress String   @map("ip_address") @db.VarChar(45)
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, ipAddress, createdAt])
  @@map("login_attempts")
}

model Project {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages Page[]

  @@index([userId, deletedAt, updatedAt(sort: Desc)])
  @@map("projects")
}

model Page {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  title       String     @db.VarChar(150)
  slug        String     @db.VarChar(100)
  status      PageStatus @default(DRAFT)
  content     Json       @default("{}") @db.JsonB
  revision    Int        @default(1)
  isPublished Boolean    @default(false) @map("is_published")
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(6)
  publicSlug  String?    @unique @map("public_slug") @db.VarChar(120)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions      PageVersion[]
  exportLogs    ExportLog[]
  aiGenerations AiGeneration[]

  @@index([projectId, deletedAt, updatedAt(sort: Desc)])
  @@map("pages")
}

model PageVersion {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId    String        @map("page_id") @db.Uuid
  content   Json          @db.JsonB
  revision  Int
  source    VersionSource
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt(sort: Desc)])
  @@map("page_versions")
}

model Template {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  content     Json     @db.JsonB
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("templates")
}

model ExportLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  revision  Int
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([pageId])
  @@map("export_logs")
}

model AiProvider {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String   @db.VarChar(80)
  baseUrl         String   @map("base_url") @db.VarChar(300)
  apiKeyEncrypted String   @map("api_key_encrypted") @db.Text
  apiKeyLast4     String   @map("api_key_last4") @db.VarChar(4)
  model           String   @db.VarChar(120)
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(4096) @map("max_tokens")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations AiGeneration[]

  @@index([userId])
  @@map("ai_providers")
}

model AiGeneration {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  pageId           String?  @map("page_id") @db.Uuid
  providerId       String?  @map("provider_id") @db.Uuid
  mode             AiMode
  prompt           String   @db.Text
  status           AiStatus
  errorCode        String?  @map("error_code") @db.VarChar(40)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  catalogVersion   String?  @map("catalog_version") @db.VarChar(40)
  durationMs       Int      @map("duration_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  page     Page?       @relation(fields: [pageId], references: [id], onDelete: SetNull)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([pageId])
  @@map("ai_generations")
}
